{
  "name": "hebrew-reader",
  "version": "0.1.0",
  "private": true,
  "description": "Dan's Hebrew reader: real articles, words tinted from his map, a card per word, marks recorded on the spine.",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "COOKIE_INSECURE=1 node server.js",
    "smoke": "node scripts/smoke.mjs",
    "screenshots": "node scripts/screenshots.mjs && node scripts/desk-pages.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "^12.4.1",
    "jsdom": "^27.0.0",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "playwright": "^1.56.1"
  }
}
