{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit(/**)",
      "Bash(npm test *)",
      "Bash(npm run *)",
      "Bash(npm ci *)",
      "Bash(npm install *)",
      "Bash(node *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh run watch *)"
    ],
    "ask": [
      "Bash(gh pr merge *)",
      "Bash(gh workflow run *)",
      "Bash(gh api *)"
    ],
    "deny": [
      "Bash(fly *)",
      "Bash(flyctl *)",
      "Bash(npm publish *)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push --delete *)",
      "Bash(git push * --delete *)",
      "Bash(git push * -d *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git branch --delete *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo rename *)",
      "Bash(gh repo archive *)",
      "Bash(sqlite3 *)",
      "Bash(node scripts/import-lessons.js *)",
      "Bash(* scripts/import-lessons.js *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/check.mjs",
              "--hook"
            ],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
